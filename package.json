{
  "name": "principled-npr-docs",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "docs:generate": "node Tools/docs.mjs generate && node Tools/generate_principled_parameter_chart.mjs",
    "docs:check": "node Tools/docs.mjs check && node Tools/generate_principled_parameter_chart.mjs --check",
    "docs:dev": "npm run docs:check && vitepress dev docs --host 127.0.0.1",
    "docs:build": "npm run docs:check && vitepress build docs && node Tools/check_docs_build.mjs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1"
  },
  "devDependencies": { "vitepress": "1.6.4" }
}
